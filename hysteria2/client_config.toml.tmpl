# Address of the Hysteria2 server to connect to.
# The host:port of the remote Hysteria2 server the client establishes a connection with.
# Allowed: Valid host:port
# Example: "example.com:36712"
server_addr = "{{ .ServerAddr }}"

# Credential used to authenticate with the server.
# The UUID presented to the server's authentication backend to authorize the connection.
# Allowed: Valid UUID
# Example: "123e4567-e89b-12d3-a456-426614174000"
auth = "{{ .Auth }}"

# SHA-256 certificate fingerprint used to pin the server's TLS certificate.
# Lets the client trust the server's self-signed certificate by matching this hex-encoded pin.
# Allowed: Hex-encoded SHA-256 fingerprint (colons optional)
# Example: "8a2b3c4d..."
tls_pin = "{{ .TLSPin }}"

# Name of the TUN network interface created by the client.
# The local virtual network interface through which the client routes tunneled traffic.
# Allowed: Valid network interface name
# Example: "hyst0"
tun_iface = "{{ .TUNIface }}"

# IP addresses assigned to the client's TUN interface in CIDR notation.
# The local addresses configured on the virtual interface for tunneled traffic.
# Allowed: Valid IPv4/IPv6 CIDR notation
# Example: "100.100.100.101/30"
addrs = [{{ range $i, $a := .Addrs }}{{ if $i }}, {{ end }}"{{ $a }}"{{ end }}]

# IP ranges routed through the tunnel.
# Traffic matching these ranges is sent through the Hysteria2 TUN interface.
# Allowed: Valid IPv4/IPv6 CIDR notation
# Example: "0.0.0.0/0"
route_addrs = [{{ range $i, $a := .RouteAddrs }}{{ if $i }}, {{ end }}"{{ $a }}"{{ end }}]

# IP ranges excluded from the tunnel.
# Traffic matching these ranges bypasses the tunnel and uses the default route.
# Allowed: Valid IPv4/IPv6 CIDR notation
# Example: "192.168.0.0/16"
exclude_addrs = [{{ range $i, $a := .ExcludeAddrs }}{{ if $i }}, {{ end }}"{{ $a }}"{{ end }}]

# Maximum transmission unit size for the TUN interface.
# The MTU applied to the virtual interface created by the client.
# Allowed: Non-zero uint16
# Example: 1420
mtu = {{ .MTU }}

# Salamander obfuscation password for masking QUIC traffic.
# Must match the server's obfs password; an empty value disables obfuscation.
# Allowed: Any string, or empty to disable
# Example: "a-strong-obfs-password"
obfs_password = "{{ .ObfsPassword }}"
