# IPv4 address in CIDR format
ipv4_addr = "{{ .IPv4Addr }}"

# IPv6 address in CIDR format
ipv6_addr = "{{ .IPv6Addr }}"

# Path to the Public Key Infrastructure (PKI) directory
pki_dir = "{{ .PKIDir }}"

# Server port
port = "{{ .Port }}"

# Transport protocol: either "udp" or "tcp"
protocol = "{{ .Protocol }}"
