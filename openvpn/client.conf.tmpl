client
dev tun
proto {{ .Protocol }}
remote {{ .Addr }} {{ .Port }}
nobind
ca "{{ filepathJoin .PKIDir "ca.crt" }}"
cert "{{ filepathJoin .PKIDir "client.crt" }}"
key "{{ filepathJoin .PKIDir "client.key" }}"
tls-crypt "{{ filepathJoin .PKIDir "tls.key" }}"
auth-nocache
auth SHA256
cipher AES-256-GCM
data-ciphers AES-256-GCM:AES-128-GCM
tls-cipher TLS-ECDHE-ECDSA-WITH-AES-256-GCM-SHA384
tls-client
tls-version-min 1.2
topology subnet
explicit-exit-notify 1
persist-key
persist-tun
management 127.0.0.1 2323
